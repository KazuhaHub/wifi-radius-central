# Copy to .env next to compose.yaml and fill in. Never commit the real file (chmod 600).
# The container validates every setting at start and exits with a message naming each bad item.
# The addresses below are documentation examples only.
#
# RADIUS secrets must not contain: " \ $ { } # or a newline. They are special in FreeRADIUS
# configuration or in .env files. Generate them with: openssl rand -hex 16

# --- RADIUS (both roles) -----------------------------------------------------------------------

# The addresses to listen on (UDP): comma-separated IPv4, no spaces. Loopback (for local tests and
# monitoring) and this host's private-network address. 0.0.0.0 is refused.
LISTEN_ADDRS=127.0.0.1,192.0.2.10

# The networks the sites send RADIUS from: one or more IPv4 addresses or CIDRs, comma-separated.
# Each becomes one client (sites-1, sites-2, ...). Prefixes shorter than /8, 0.x and loopback are refused.
SITE_CLIENTS=198.51.100.0/24,203.0.113.0/24

# Shared secret with the sites (the CENTRAL_SECRET of every site), and the secret of the local client 127.0.0.1.
RADIUS_SECRET_SITES=
RADIUS_SECRET_LOCAL=

# --- Microsoft Entra ID (both roles; read by the entra-auth container) -----------------------------

# The app registration (a confidential client with a certificate credential): see
# https://github.com/KazuhaHub/entra-forward-auth. The certificate and key go in ./entra-cred
# as client.pem and client.key (the key readable by UID 65532).
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_SCOPE=api://00000000-0000-0000-0000-000000000000/Access
# Only users of these domains are sent to Entra at all (comma-separated).
ENTRA_ALLOWED_DOMAINS=example.com

# --- certificate service (both roles; read by the cert-dist container) -----------------------------

# IPv4:port that cert-dist listens on: this host's private-network address, never a public one.
CERT_DIST_LISTEN=192.0.2.10:11880

# PRIMARY: the account of the backup node that may also fetch the accounts file (/htpasswd).
# Create it with host/cert-account. BACKUP: leave empty.
CERT_DIST_BACKUP_USER=

# What cert-dist serves. PRIMARY: leave out (default ./dist). BACKUP: cert-dist (the named volume).
# CERT_DIST_DIR=cert-dist

# --- BACKUP role only ------------------------------------------------------------------------------
# Setting CERT_SYNC_URL makes this host the backup. On the primary, leave all three out.

# The primary's certificate service: comma-separated http://IPv4:port (plain http, no path), in
# fail-over order. The certificate set and the accounts file are taken from the first one that works.
# CERT_SYNC_URL=http://192.0.2.10:11880

# This host's own account on the primary (host/cert-account add NAME) and its password.
# CERT_SYNC_USER=
# CERT_SYNC_PASSWORD=

# --- Not needed normally ------------------------------------------------------------------------------
# Optional knobs for tests and tuning; leave them out in normal use. They have generic defaults (shown).
# The CA fingerprint the certificate set must carry is not a setting: it is built into the image
# (CA_SHA256 in the Dockerfile).
# LISTEN_PORT=11812
# CERT_SYNC_INTERVAL=600
# ENTRA_AUTH_URL=http://127.0.0.1:5002/auth
