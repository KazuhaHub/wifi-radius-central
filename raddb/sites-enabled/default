# Central Wi-Fi RADIUS: the outer (real) server.
#  - plain PAP from the site proxies (they terminate EAP-TTLS locally and forward only the inner request)
#  - EAP-TTLS directly (an AP pointed here, or tests); its inner PAP is checked in "inner-tunnel"
# Both end in the `entra` module (see mods-enabled/entra).
# The listen sections are generated at start from LISTEN_ADDRS / LISTEN_PORT; which hosts may talk to them
# is decided by the generated clients.conf (SITE_CLIENTS, plus the local client 127.0.0.1); anything else is dropped.
server default {
	$INCLUDE /etc/freeradius/listen.conf

	authorize {
		# The Status-Server probes of the site proxies (they use them to detect a dead central server).
		# Answered only while entra-auth is ready: a central server that cannot check passwords must look
		# dead, so that the sites send their logins to the other one.
		Autz-Type Status-Server {
			entra_ready
			if (!(ok || updated)) {
				do_not_respond
			}
			else {
				ok
			}
		}
		filter_username
		eap {
			ok = return
		}
		if (&User-Password) {
			# Basic auth cannot carry a ':' in the user name, and an empty password is never valid.
			if ((&User-Name =~ /:/) || (&User-Password == "")) {
				reject
			}
			update control {
				&Auth-Type := entra
			}
		}
	}

	authenticate {
		eap
		# 204 from entra-auth is the only accept. A failure of the service itself (no answer, timeout,
		# connection refused, 5xx, no free connection) is NOT a reject: the request is dropped without a
		# reply, so the site's home server times out and fails over to the other central server. Anything
		# else (401, other 4xx, a 200 ...) is a reject.
		# rlm_rest leaves "return" as the action for most results, which would end this group before the
		# checks below; the actions are set to 1 (carry on) so that the decision is made here, from the
		# HTTP status code alone (rlm_rest sets REST-HTTP-Status-Code when an answer arrived).
		Auth-Type entra {
			entra {
				ok = 1
				fail = 1
				reject = 1
				invalid = 1
				notfound = 1
				userlock = 1
			}
			if (!&reply:REST-HTTP-Status-Code || (&reply:REST-HTTP-Status-Code >= 500)) {
				# The shipped policy: Response-Packet-Type := Do-Not-Respond in the control list, then `handled`.
				do_not_respond
			}
			elsif (&reply:REST-HTTP-Status-Code == 204) {
				update reply {
					&REST-HTTP-Status-Code !* ANY
				}
				ok
			}
			else {
				reject
			}
		}
	}

	post-auth {
		Post-Auth-Type REJECT {
			attr_filter.access_reject
			eap
			remove_reply_message_if_eap
		}
	}
}
