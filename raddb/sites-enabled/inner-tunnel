# Inside the EAP-TTLS tunnel: the inner PAP request goes to Microsoft Entra ID (module `entra`).
# No listen section: it is only reached through the eap module, so it opens no port on the host.
server inner-tunnel {

	authorize {
		filter_username
		if (!&User-Password) {
			reject
		}
		if ((&User-Name =~ /:/) || (&User-Password == "")) {
			reject
		}
		update control {
			&Auth-Type := entra
		}
	}

	authenticate {
		Auth-Type entra {
			entra
		}
	}

	post-auth {
		Post-Auth-Type REJECT {
			attr_filter.access_reject
		}
	}
}
