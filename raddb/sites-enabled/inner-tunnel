# Inside the EAP-TTLS tunnel: the inner PAP request goes to Microsoft Entra ID (module `entra`).
# No listen section: it is only reached through the eap module, so it opens no port on the host.
server inner-tunnel {

	authorize {
		filter_username
		if (!&User-Password) {
			reject
		}
		if ((!&User-Name) || (&User-Name == "") || (&User-Name =~ /:/) || (&User-Password == "")) {
			reject
		}
		update control {
			&Auth-Type := entra
		}
	}

	authenticate {
		# Only a 204 from entra-auth accepts (rlm_rest alone would accept any 2xx). Everything else, a
		# failure of the service included, is a reject: an AP that terminates EAP-TTLS here has no
		# other central server to fail over to (the site proxies send plain PAP to the default server).
		# The module's actions are set to 1 (carry on) so that the decision is made here, from the HTTP status code.
		Auth-Type entra {
			entra {
				ok = 1
				fail = 1
				reject = 1
				invalid = 1
				notfound = 1
				userlock = 1
			}
			update control {
				&Response-Packet-Type !* ANY
			}
			update reply {
				&Response-Packet-Type !* ANY
			}
			if (("%{reply:REST-HTTP-Status-Code[#]}" == "1") && (&reply:REST-HTTP-Status-Code == 204)) {
				update reply {
					&REST-HTTP-Status-Code !* ANY
				}
				ok
			}
			else {
				reject
			}
		}
	}

	post-auth {
		Post-Auth-Type REJECT {
			attr_filter.access_reject
		}
	}
}
